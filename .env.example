# ---------------------------------------------------------------------------
# Copy to .env and edit. Placeholders only: never commit real values.
# ---------------------------------------------------------------------------

# --- HTTP server ---
# Loopback by default. Binding to anything else REQUIRES API_AUTH_TOKEN.
HOST=127.0.0.1
PORT=3000
NODE_ENV=development
# Bearer token for every endpoint except GET /health (min 16 chars).
# Required when NODE_ENV=production or HOST is not loopback.
# Generate one with:  openssl rand -hex 32
API_AUTH_TOKEN=

# --- Data (relative paths are resolved from the repository root) ---
DATABASE_PATH=data/report.db
REPORTS_DIR=reports
# Account/session metadata is stored separately. On hosts with a persistent mount, set this path inside that mount.
AUTH_DATABASE_PATH=data/auth.sqlite
# Per-organisation CSV-backed SQLite datasets and PDFs (never served as static files). On persistent hosts, put this inside the mount.
CUSTOM_DATA_DIR=custom-data

# Google OAuth (optional locally; configure in Google Cloud Console before enabling).
# Set the exact authorized callback URL to https://YOUR_PUBLIC_HOST/auth/google/callback.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
# Public browser demo storage is physically separate from the private reporting data.
DEMO_DATABASE_PATH=demo-data/demo-report.db
DEMO_REPORTS_DIR=demo-data/reports
REPORT_CURRENCY=USD
COMPANY_NAME=The Little Shop

# --- PDF rendering (Puppeteer) ---
# Leave empty to use the Chrome that `npx puppeteer browsers install chrome` installs.
# Set to use an existing Chrome/Chromium instead, e.g. /usr/bin/chromium
PUPPETEER_EXECUTABLE_PATH=
# Needed in many containers / when running as root (disables the Chrome sandbox).
PUPPETEER_NO_SANDBOX=false
PDF_CHART_TIMEOUT_MS=15000
# Reports stuck in "pending" longer than this are marked failed at startup.
STALE_REPORT_AFTER_MS=900000

# --- Weekly scheduler (off by default) ---
ENABLE_SCHEDULER=false
# Monday 08:00 in REPORT_TIMEZONE
REPORT_CRON_SCHEDULE=0 8 * * 1
REPORT_TIMEZONE=UTC

# --- Email via Resend (off by default) ---
# Scheduled runs email only when EMAIL_ENABLED=true.
EMAIL_ENABLED=false
# API key from https://resend.com/api-keys (starts with "re_"). Never commit a real key.
RESEND_API_KEY=
# Sender. Plain address or display-name form, e.g. reports@yourdomain.com or Reports <reports@yourdomain.com>.
# Without a verified domain Resend only allows onboarding@resend.dev, and only to your own account email.
EMAIL_FROM=
# One recipient, or several separated by commas (Resend allows up to 50 per email).
EMAIL_TO=
# A "sending" claim older than this may be re-claimed (crash recovery).
EMAIL_CLAIM_TIMEOUT_MS=600000

# --- CSV import limits ---
# Largest accepted import file (MB) and most data rows per file.
IMPORT_MAX_FILE_MB=5
IMPORT_MAX_ROWS=50000

# Optional cloud/free deployment mode (only used by `npm run start:cloud`).
# Keep the Supabase service-role key server-side; never expose it in frontend code.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Legacy fallback only; prefer the current sb_secret_* key above.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=execubrief-private
