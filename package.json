{
  "name": "executive-pdf-report",
  "version": "1.1.0",
  "private": true,
  "description": "ExecuBrief executive analytics dashboard with organisation workspaces, CSV imports, and real PDF reporting",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "seed": "node scripts/seed.js",
    "seed:demo": "node scripts/seed-demo.js",
    "test": "node --test --test-concurrency=1 \"test/**/*.test.js\"",
    "test:query": "node --test test/analytics.test.js",
    "test:render": "node --test test/renderer.test.js",
    "report": "node scripts/generate-report.js",
    "test:real": "node scripts/test-real.js",
    "audit": "npm audit --audit-level=moderate",
    "import:check": "node scripts/import-orders.js --dry-run",
    "import:orders": "node scripts/import-orders.js",
    "orders:summary": "node scripts/orders-summary.js",
    "sample:csv": "node scripts/generate-sample-csv.js",
    "dashboard:init": "node scripts/init-demo.js",
    "demo:init": "node scripts/init-demo.js"
  },
  "dependencies": {
    "chart.js": "^4.5.0",
    "dotenv": "^16.6.1",
    "express": "^4.21.2",
    "handlebars": "^4.7.8",
    "node-cron": "^4.6.0",
    "puppeteer": "^25.12.0",
    "resend": "^6.32.1"
  },
  "devDependencies": {
    "pdfjs-dist": "^6.4.299"
  }
}
